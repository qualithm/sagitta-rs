# Multi-arch release image. CI builds the binary for each architecture and
# this copies it onto distroless/cc, so no step runs under emulation.
# Expects pre-built binaries in binaries/linux/{amd64,arm64}/.

# Pin the image-index digest — a child-manifest digest can resolve to an
# attestation manifest (platform unknown/unknown), which BuildKit cannot run.
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:08476c244888bfb425bae1ae4dd7c17f093e972aab8426883d97f3c6f280f7c1

ARG TARGETARCH

COPY --chmod=0755 binaries/linux/${TARGETARCH}/sagitta /usr/local/bin/sagitta

USER 65532:65532

# Default configuration directory
ENV SAGITTA_CONFIG=/etc/sagitta/config.toml

# Expose Flight gRPC port. The image has no shell, so it carries no
# HEALTHCHECK: probe the Flight `healthcheck` action instead.
EXPOSE 50051

ENTRYPOINT ["/usr/local/bin/sagitta"]
