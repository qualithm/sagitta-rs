# Multi-arch release Dockerfile
# Expects pre-built binaries in binaries/linux/{amd64,arm64}/

# Pin the image-index digest — a child-manifest digest can resolve to an
# attestation manifest (platform unknown/unknown), which BuildKit cannot run.
FROM debian:trixie-20260918-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

ARG TARGETARCH

# Binary name passed from CI workflow
ARG BINARY_NAME=sagitta
ENV BINARY_NAME=${BINARY_NAME}

# Install minimal runtime dependencies. Upgrade first so Debian security fixes
# land without waiting for upstream to rebuild the pinned base image.
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Copy the pre-built binary for the target architecture
COPY binaries/linux/${TARGETARCH}/${BINARY_NAME} /usr/local/bin/${BINARY_NAME}
RUN chmod +x /usr/local/bin/${BINARY_NAME}

# Create non-root user
RUN useradd --create-home --user-group app
USER app

# Default configuration directory
ENV SAGITTA_CONFIG=/etc/sagitta/config.toml

# Expose Flight gRPC port
EXPOSE 50051

# Healthcheck using netcat
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD nc -z localhost 50051

ENTRYPOINT ["sh", "-c", "exec \"/usr/local/bin/$BINARY_NAME\" \"$@\"", "--"]
